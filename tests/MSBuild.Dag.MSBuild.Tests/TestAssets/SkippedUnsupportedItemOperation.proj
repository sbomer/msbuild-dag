<Project>
  <PropertyGroup>
    <EnableItem>false</EnableItem>
  </PropertyGroup>

  <ItemGroup>
    <I Include="existing" />
  </ItemGroup>

  <Target Name="Build">
    <ItemGroup>
      <I
        Include="new"
        Metadata="value"
        Condition="'$(EnableItem)' == 'true'" />
    </ItemGroup>
  </Target>
</Project>
