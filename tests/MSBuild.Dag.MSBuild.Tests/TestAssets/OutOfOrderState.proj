<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <Target Name="Build"
          DependsOnTargets="Prepare">
    <ToyCompile Sources="@(Compile)"
                Configuration="$(Configuration)">
      <Output TaskParameter="Assembly"
              PropertyName="AssemblyPath" />
    </ToyCompile>
  </Target>

  <Target Name="Prepare">
    <PropertyGroup>
      <Configuration>Debug</Configuration>
    </PropertyGroup>
  </Target>
</Project>
