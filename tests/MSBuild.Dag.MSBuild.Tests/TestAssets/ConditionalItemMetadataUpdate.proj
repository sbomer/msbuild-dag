<Project>
  <ItemGroup>
    <SubsetName Include="clr" OnDemand="false" Text="- clr" />
    <SubsetName Include="libs" OnDemand="true" Text="- libs" />
  </ItemGroup>

  <Target Name="Build">
    <ItemGroup>
      <SubsetName
        Condition="'%(SubsetName.OnDemand)' == 'true'"
        Text="%(Text) [only runs on demand]" />
    </ItemGroup>
    <Message
      Importance="high"
      Text="@(SubsetName->'%(Text)', '; ')" />
  </Target>
</Project>
