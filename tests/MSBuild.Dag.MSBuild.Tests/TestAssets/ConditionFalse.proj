<Project>
  <PropertyGroup>
    <RunBuild>false</RunBuild>
  </PropertyGroup>

  <Target Name="Build"
          Condition="'$(RunBuild)' == 'true'">
    <PropertyGroup>
      <Configuration>Debug</Configuration>
    </PropertyGroup>

    <ItemGroup>
      <Compile Include="Program.cs" />
    </ItemGroup>

    <ToyCompile Sources="@(Compile)"
                Configuration="$(Configuration)">
      <Output TaskParameter="Assembly"
              PropertyName="AssemblyPath" />
    </ToyCompile>
  </Target>
</Project>
