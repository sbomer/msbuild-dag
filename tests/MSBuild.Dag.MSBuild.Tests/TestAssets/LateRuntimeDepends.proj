<Project>
  <PropertyGroup>
    <BuildDependsOn>Prepare</BuildDependsOn>
  </PropertyGroup>

  <Target Name="Prepare" />

  <Target Name="Build"
          DependsOnTargets="$(BuildDependsOn)" />

  <Target Name="RewriteDependencies">
    <PropertyGroup>
      <BuildDependsOn />
    </PropertyGroup>
  </Target>

  <Target Name="Entry"
          DependsOnTargets="Build;RewriteDependencies" />
</Project>
