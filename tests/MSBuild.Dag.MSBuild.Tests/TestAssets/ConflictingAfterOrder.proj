<Project>
  <Target Name="A"
          AfterTargets="B">
    <PropertyGroup>
      <Property>SetByA</Property>
    </PropertyGroup>
  </Target>

  <Target Name="B">
    <PropertyGroup>
      <Property>SetByB</Property>
    </PropertyGroup>
  </Target>

  <Target Name="Build"
          DependsOnTargets="A;B" />
</Project>
