<Project>
  <PropertyGroup>
    <Run>true</Run>
    <X>old-x</X>
    <Y>old-y</Y>
    <Z>old-z</Z>
  </PropertyGroup>

  <Target Name="Build">
    <PropertyGroup Condition="'$(Run)' == 'true'">
      <X>new-x</X>
      <Y Condition="'$(X)' == 'new-x'">new-y</Y>
      <Z Condition="'$(X)' == 'other'">new-z</Z>
    </PropertyGroup>
  </Target>
</Project>
