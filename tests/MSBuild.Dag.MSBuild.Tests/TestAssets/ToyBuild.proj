<Project>
  <PropertyGroup>
    <RunBuild>true</RunBuild>
    <RunSkippedBuild>false</RunSkippedBuild>
    <Configuration>Release</Configuration>
  </PropertyGroup>

  <Target Name="Build"
          Condition="'$(RunBuild)' == 'true'">
    <PropertyGroup>
      <Configuration>Debug</Configuration>
    </PropertyGroup>

    <ItemGroup>
      <Compile Include="Program.cs" />
    </ItemGroup>

    <ToyCompile Sources="@(Compile)"
                Configuration="$(Configuration)">
      <Output TaskParameter="Assembly"
              PropertyName="AssemblyPath" />
    </ToyCompile>
  </Target>

  <Target Name="SkippedBuild"
          Condition="'$(RunSkippedBuild)' == 'true'">
    <PropertyGroup>
      <Configuration>ShouldNotBeObserved</Configuration>
    </PropertyGroup>
  </Target>

  <Target Name="AfterSkippedBuild"
          DependsOnTargets="SkippedBuild">
    <PropertyGroup>
      <ObservedConfiguration>$(Configuration)</ObservedConfiguration>
    </PropertyGroup>
  </Target>
</Project>
