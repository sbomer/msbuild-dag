<Project>
  <PropertyGroup>
    <Run>false</Run>
    <X>old-x</X>
  </PropertyGroup>

  <ItemGroup>
    <I Include="a.txt" />
  </ItemGroup>

  <Target Name="Build">
    <PropertyGroup Condition="'$(Run)' == 'true'">
      <X Condition="'%(I.Extension)' == '.txt'">new-x</X>
    </PropertyGroup>
  </Target>
</Project>
