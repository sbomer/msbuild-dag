<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <Target Name="UnrelatedWriter">
    <PropertyGroup>
      <Configuration>Incorrect</Configuration>
    </PropertyGroup>
  </Target>

  <Target Name="Build">
    <ToyCompile Sources="@(Compile)"
                Configuration="$(Configuration)" />
  </Target>
</Project>
