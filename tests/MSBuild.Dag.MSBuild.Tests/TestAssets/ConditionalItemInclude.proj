<Project>
  <PropertyGroup>
    <IncludeA>true</IncludeA>
    <IncludeB>false</IncludeB>
    <Build>true</Build>
    <Rebuild>false</Rebuild>
    <Phrase>foo and bar</Phrase>
  </PropertyGroup>

  <ItemGroup>
    <I Include="existing" />
  </ItemGroup>

  <Target Name="Build">
    <ItemGroup>
      <I Include="a"
         Condition="'$(IncludeA)' == 'true'" />
      <I Include="b"
         Condition="'$(IncludeB)' == 'true'" />
      <I Include="build"
         Condition="'$(Build)' == 'true' and '$(Rebuild)' != 'true'" />
      <I Include="rebuild"
         Condition="'$(Build)' == 'true' and '$(Rebuild)' == 'true'" />
      <I Include="phrase"
         Condition="'$(Phrase)' == 'foo and bar'" />
    </ItemGroup>
  </Target>
</Project>
