<Project>
  <PropertyGroup>
    <IncludeA>true</IncludeA>
    <IncludeB>false</IncludeB>
    <Build>true</Build>
    <Rebuild>false</Rebuild>
    <Phrase>foo and bar</Phrase>
    <OrLeft>false</OrLeft>
    <OrRight>true</OrRight>
    <PhraseOr>foo or bar</PhraseOr>
    <PrecedenceA>false</PrecedenceA>
    <PrecedenceB>true</PrecedenceB>
    <PrecedenceC>true</PrecedenceC>
  </PropertyGroup>

  <ItemGroup>
    <I Include="existing" />
  </ItemGroup>

  <Target Name="Build">
    <ItemGroup>
      <I Include="a"
         Condition="'$(IncludeA)' == 'true'" />
      <I Include="b"
         Condition="'$(IncludeB)' == 'true'" />
      <I Include="build"
         Condition="'$(Build)' == 'true' and '$(Rebuild)' != 'true'" />
      <I Include="rebuild"
         Condition="'$(Build)' == 'true' and '$(Rebuild)' == 'true'" />
      <I Include="phrase"
         Condition="'$(Phrase)' == 'foo and bar'" />
      <I Include="or"
         Condition="'$(OrLeft)' == 'true' or '$(OrRight)' == 'true'" />
      <I Include="or-false"
         Condition="'$(OrLeft)' == 'true' or '$(OrRight)' != 'true'" />
      <I Include="phrase-or"
         Condition="'$(PhraseOr)' == 'foo or bar'" />
      <I Include="precedence"
         Condition="'$(PrecedenceA)' == 'true' and '$(PrecedenceB)' == 'true' or '$(PrecedenceC)' == 'true'" />
    </ItemGroup>
  </Target>
</Project>
