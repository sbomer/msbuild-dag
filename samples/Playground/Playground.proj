<Project>
    <PropertyGroup>
        <Key>V0</Key>
        <Subset>clr+libs-native</Subset>
    </PropertyGroup>

    <Target Name="A">
        <PropertyGroup>
            <Key>V1</Key>
        </PropertyGroup>
    </Target>

    <Target Name="B"
            AfterTargets="A">
        <ItemGroup>
            <SpecifiedSubsetName Include="$([MSBuild]::Unescape($(Subset.Replace('+', ';').Replace('-', ';'))))" />
        </ItemGroup>
        <Message Text="$(Key)" />
        <PropertyGroup>
            <Key>V2</Key>
        </PropertyGroup>
    </Target>

    <Target Name="Build"
            DependsOnTargets="A">
    </Target>
</Project>
