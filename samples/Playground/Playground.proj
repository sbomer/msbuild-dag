<Project>
  <ItemGroup>
    <SubsetName Include="clr"
                OnDemand="false"
                Text="CoreCLR" />
    <SubsetName Include="libs"
                OnDemand="true"
                Text="Libraries" />
  </ItemGroup>

  <Target Name="Build">
    <ItemGroup>
      <SubsetName Text="- %(Identity)" />
      <SubsetName
        Condition="'%(OnDemand)' == 'true'"
        Text="%(Text) [only runs on demand]" />
    </ItemGroup>
    <Message
      Importance="high"
      Text="@(SubsetName->'%(Text)', '; ')" />
  </Target>
</Project>
